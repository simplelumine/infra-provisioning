{
  "log": {
    "loglevel": "warning"
  },
  {% if xray_enable_stats | default(false) %}
  "stats": {},
  "api": {
    "tag": "api",
    "services": [
      "StatsService"
    ]
  },
  "policy": {
    "levels": {
      "0": {
        "statsUserUplink": true,
        "statsUserDownlink": true
      }
    },
    "system": {
      "statsInboundUplink": true,
      "statsInboundDownlink": true
    }
  },
  {% endif %}
  "inbounds": [
    {
      "listen": "0.0.0.0",
      "port": {{ xray_port_tcp }},
      "protocol": "vless",
      "settings": {
        "clients": [
          {% set all_clients = xray_clients + (xray_host_clients | default([])) %}
          {% for client in all_clients %}
          {
            "id": "{{ client.id }}",
            "flow": "xtls-rprx-vision"{% if client.email is defined and client.email != "" %},
            "email": "{{ client.email }}"{% endif %}
          }{{ "," if not loop.last else "" }}
          {% endfor %}
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": "{{ xray_reality_dest }}",
          "xver": 0,
          "serverNames": {{ xray_reality_server_names | to_json }},
          "privateKey": "{{ xray_private_key }}",
          "shortIds": {{ xray_short_ids | to_json }}
        }
      }
      {% if xray_enable_sniffing | default(true) %}
      ,
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls", "quic"],
        "routeOnly": true
      }
      {% endif %}
    }
    {% if xray_enable_stats | default(false) %}
    ,
    {
      "listen": "127.0.0.1",
      "port": {{ xray_api_port }},
      "protocol": "dokodemo-door",
      "settings": {
        "address": "127.0.0.1"
      },
      "tag": "api"
    }
    {% endif %}
  ],
  "outbounds": [
    {
      "protocol": "freedom",
      "tag": "direct"
    }
    {% if xray_enable_stats | default(false) %}
    ,
    {
      "protocol": "freedom",
      "tag": "api"
    }
    {% endif %}
  ],
  "routing": {
    "rules": [
      {% if xray_enable_stats | default(false) %}
      {
        "type": "field",
        "inboundTag": ["api"],
        "outboundTag": "api"
      }
      {% endif %}
    ]
  }
}
