{
  "log": {
    "loglevel": "warning"
  },
  "stats": {},
  "api": {
    "tag": "api",
    "services": [
      "StatsService"
    ]
  },
  "policy": {
    "levels": {
      "0": {
        "statsUserUplink": true,
        "statsUserDownlink": true
      }
    },
    "system": {
      "statsInboundUplink": true,
      "statsInboundDownlink": true
    }
  },
  "inbounds": [
    {
      "listen": "0.0.0.0",
      "port": {{ xray_port_tcp }},
      "protocol": "vless",
      "settings": {
        "clients": [
          {% set all_clients = xray_clients + (xray_host_clients | default([])) %}
          {% for client in all_clients %}
          {
            "id": "{{ client.id }}",
            "flow": "xtls-rprx-vision"
          }{{ "," if not loop.last else "" }}
          {% endfor %}
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": "www.microsoft.com:443",
          "xver": 0,
          "serverNames": [ "www.microsoft.com" ],
          "privateKey": "{{ xray_private_key }}",
          "shortIds": [ "abcdef", "1a2b3c" ]
        }
      }
    }
    {% if xray_relay_rules is defined and xray_relay_rules | length > 0 %}
    ,
    {% for rule in xray_relay_rules %}
    {
      "listen": "0.0.0.0",
      "port": {{ rule.listen }},
      "protocol": "dokodemo-door",
      "settings": {
        "address": "{{ rule.target_addr }}",
        "port": {{ rule.target_port }},
        "network": "tcp,udp"
      },
      "tag": "relay-{{ loop.index }}"
    }{{ "," if not loop.last else "" }}
    {% endfor %}
    {% endif %}
  ],
  "outbounds": [
    {
      "protocol": "freedom",
      "tag": "direct"
    }
    {% if xray_relay_rules is defined and xray_relay_rules | length > 0 %}
    ,
    {% for rule in xray_relay_rules %}
    {
      "protocol": "freedom",
      "tag": "relay-out-{{ loop.index }}"
    }{{ "," if not loop.last else "" }}
    {% endfor %}
    {% endif %}
  ],
  "routing": {
    "rules": [
      {% if xray_relay_rules is defined and xray_relay_rules | length > 0 %}
      {% for rule in xray_relay_rules %}
      {
        "type": "field",
        "inboundTag": ["relay-{{ loop.index }}"],
        "outboundTag": "relay-out-{{ loop.index }}"
      }{{ "," if not loop.last else "" }}
      {% endfor %}
      {% endif %}
    ]
  }
}
