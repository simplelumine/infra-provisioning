# Traefik Static Configuration - Managed by Ansible
global:
  checkNewVersion: false
  sendAnonymousUsage: false

log:
  level: INFO

entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
          permanent: true
  websecure:
    address: ":443"

certificatesResolvers:
  letsencrypt:
    acme:
      email: "{{ traefik_acme_email }}"
      storage: "/etc/traefik/acme.json"
      httpChallenge:
        entryPoint: "web"

providers:
  file:
    directory: "/etc/traefik/conf.d"
    watch: true

{% if traefik_enable_dashboard | default(false) %}
api:
  dashboard: true
  insecure: true
{% endif %}
