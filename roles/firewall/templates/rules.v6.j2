# Managed by Ansible - DO NOT EDIT MANUALLY
*filter
:INPUT DROP [0:0]
:FORWARD ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
:ANSIBLE-FW6 - [0:0]

# Base safety rules on INPUT
-A INPUT -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
-A INPUT -i lo -j ACCEPT
-A INPUT -p tcp -m tcp --dport 22 -j ACCEPT
-A INPUT -j ANSIBLE-FW6

# ANSIBLE-FW6 Chain Rules
-A ANSIBLE-FW6 -i lo -j ACCEPT
-A ANSIBLE-FW6 -p ipv6-icmp -j ACCEPT

{% if firewall_enable_cluster_trust | bool %}
# Flannel WireGuard & CNI interfaces
-A ANSIBLE-FW6 -i flannel-wg -j ACCEPT
-A ANSIBLE-FW6 -i cni0 -j ACCEPT

# Public K3s / WireGuard ports
{% for port in firewall_allowed_tcp_ports %}
-A ANSIBLE-FW6 -p tcp -m tcp --dport {{ port }} -j ACCEPT
{% endfor %}
{% for port in firewall_allowed_udp_ports %}
-A ANSIBLE-FW6 -p udp -m udp --dport {{ port }} -j ACCEPT
{% endfor %}
{% endif %}

{% if firewall_enable_nodeports | bool %}
-A ANSIBLE-FW6 -p tcp -m tcp --dport 30000:32767 -j ACCEPT
-A ANSIBLE-FW6 -p udp -m udp --dport 30000:32767 -j ACCEPT
{% endif %}

{% if firewall_enable_ingress | bool %}
-A ANSIBLE-FW6 -p tcp -m tcp --dport 80 -j ACCEPT
-A ANSIBLE-FW6 -p tcp -m tcp --dport 443 -j ACCEPT
{% endif %}

{% if firewall_enable_tailscale_trust | bool %}
-A ANSIBLE-FW6 -i tailscale0 -j ACCEPT
-A ANSIBLE-FW6 -p udp -m udp --dport {{ tailscale_peer_relay_port | default(41641) }} -j ACCEPT
{% endif %}

{% if tailscale_derp_enabled | default(false) | bool %}
-A ANSIBLE-FW6 -p udp -m udp --dport {{ tailscale_derp_stun_port | default(3478) }} -j ACCEPT
{% endif %}

# Drop all remaining traffic
-A ANSIBLE-FW6 -j DROP

COMMIT
