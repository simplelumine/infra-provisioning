*filter
:FORWARD ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]

# Custom chain managed by Ansible (does not affect Cilium/Tailscale)
:ANSIBLE-FW - [0:0]

# 1. Base Rules (Always Active)
-A ANSIBLE-FW -i lo -j ACCEPT
-A ANSIBLE-FW -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A ANSIBLE-FW -p icmp -j ACCEPT
-A ANSIBLE-FW -p tcp --dport 22 -j ACCEPT

# 2. Tailscale Trust Zone
{% if firewall_enable_tailscale_trust | default(false) %}
-A ANSIBLE-FW -i tailscale0 -j ACCEPT
{% endif %}

# 3. Cluster Trust Zone (Trust only CLUSTER nodes' public IPs)
{% if firewall_enable_cluster_trust | default(false) %}
{% for host in groups['cluster'] | default([]) %}
{% if hostvars[host]['ansible_host'] is defined and host != inventory_hostname %}
-A ANSIBLE-FW -s {{ hostvars[host]['ansible_host'] }} -j ACCEPT
{% endif %}
{% endfor %}
{% endif %}

# 4. NodePorts (Range)
{% if firewall_enable_nodeports | default(false) %}
-A ANSIBLE-FW -p tcp --dport 30000:32767 -j ACCEPT
-A ANSIBLE-FW -p udp --dport 30000:32767 -j ACCEPT
{% endif %}

# 5. Tailscale Peer Relay
{% if tailscale_enable_peer_relay | default(false) %}
-A ANSIBLE-FW -p udp --dport {{ tailscale_peer_relay_port }} -j ACCEPT
{% endif %}

# 6. Standard Ingress (HTTP/HTTPS)
{% if firewall_enable_ingress | default(false) %}
-A ANSIBLE-FW -p tcp --dport 80 -j ACCEPT
-A ANSIBLE-FW -p tcp --dport 443 -j ACCEPT
{% endif %}

# 7. Xray Service (Dynamic Port)
{% if firewall_enable_xray | default(false) %}
-A ANSIBLE-FW -p tcp --dport {{ xray_port_tcp }} -j ACCEPT
{% endif %}

# 8. DERP STUN Port
{% if tailscale_derp_enabled | default(false) %}
-A ANSIBLE-FW -p udp --dport {{ tailscale_derp_stun_port | default(3478) }} -j ACCEPT
{% endif %}

# 9. Default DROP (anything not matched above)
-A ANSIBLE-FW -j DROP

# Jump from INPUT to our chain (persists after reboot)
-A INPUT -j ANSIBLE-FW

COMMIT
