# Managed by Ansible - DO NOT EDIT MANUALLY
*filter
:INPUT DROP [0:0]
:FORWARD ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
:ANSIBLE-FW - [0:0]

# Base safety rules on INPUT
-A INPUT -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
-A INPUT -i lo -j ACCEPT
-A INPUT -p tcp -m tcp --dport 22 -j ACCEPT
-A INPUT -j ANSIBLE-FW

# ANSIBLE-FW Chain Rules
-A ANSIBLE-FW -p icmp -j ACCEPT

{% if 'wireguard' in group_names %}
# Kernel WireGuard UDP port & trusted WireGuard interface
-A ANSIBLE-FW -p udp -m udp --dport {{ wireguard_port | default(51820) }} -j ACCEPT
-A ANSIBLE-FW -i {{ wireguard_interface | default('wg0') }} -j ACCEPT
{% endif %}

{% if 'cluster' in group_names %}
# Kubernetes CNI interfaces and Pod/Service CIDRs
-A ANSIBLE-FW -i cni0 -j ACCEPT
-A ANSIBLE-FW -i flannel.1 -j ACCEPT
-A ANSIBLE-FW -s 10.42.0.0/16 -j ACCEPT
-A ANSIBLE-FW -s 10.43.0.0/16 -j ACCEPT
{% endif %}

{% if firewall_enable_ingress | default(true) | bool %}
-A ANSIBLE-FW -p tcp -m tcp --dport 80 -j ACCEPT
-A ANSIBLE-FW -p tcp -m tcp --dport 443 -j ACCEPT
{% endif %}

{% if 'xray' in group_names and 'edge' not in group_names and (xray_port_tcp | default('') | string | length > 0) %}
-A ANSIBLE-FW -p tcp -m tcp --dport {{ xray_port_tcp }} -j ACCEPT
{% endif %}

{% if 'worker_nodes' in group_names %}
# Genshin Impact KCP GateServer UDP port
-A ANSIBLE-FW -p udp -m udp --dport 21081 -j ACCEPT
{% endif %}

{% if 'tailscale' in group_names %}
-A ANSIBLE-FW -i tailscale0 -j ACCEPT
-A ANSIBLE-FW -p udp -m udp --dport {{ tailscale_peer_relay_port | default(41641) }} -j ACCEPT
{% endif %}

{% if tailscale_derp_enabled | default(false) | bool %}
-A ANSIBLE-FW -p udp -m udp --dport {{ tailscale_derp_stun_port | default(3478) }} -j ACCEPT
{% endif %}

# Drop all remaining traffic
-A ANSIBLE-FW -j DROP

COMMIT
